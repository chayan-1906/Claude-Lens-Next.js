# ── Claude Lens frontend environment ──

# Base URL of the Claude Lens backend (server-side REST calls)
BACKEND_URL=http://localhost:20261

# WebSocket URL of the backend (used in the browser — must keep the NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:20261/ws

# Alternatively, point these at a specific host or IP instead of localhost:
#BACKEND_URL=http://<host-or-ip>:20261
#NEXT_PUBLIC_BACKEND_WS_URL=ws://<host-or-ip>:20261/ws
